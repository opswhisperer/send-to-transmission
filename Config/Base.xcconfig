// Public defaults shared by both targets. Do not put personal values here.
//
// Account-specific values live in Config/Local.xcconfig, which is gitignored.
// Create it with scripts/configure.sh, or copy Local.xcconfig.example.

// Without an overlay the app is ad-hoc signed ("Sign to Run Locally"), so a fresh
// clone builds with no Apple Developer account. The overlay sets a Team ID and
// CODE_SIGN_IDENTITY = Apple Development.
DEVELOPMENT_TEAM =
CODE_SIGN_IDENTITY = -

// Reverse-DNS prefix for both bundle identifiers:
//   $(BUNDLE_ID_PREFIX).SendToTransmission and ….SendToTransmission.Extension
BUNDLE_ID_PREFIX = com.example

// Keychain service under which the extension stores the RPC password.
TRANSMISSION_KEYCHAIN_SERVICE = $(BUNDLE_ID_PREFIX).SendToTransmission.rpc

#include? "Local.xcconfig"
