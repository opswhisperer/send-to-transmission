// Public defaults shared by both targets. Do not put personal values here.
//
// Account-specific values live in Config/Local.xcconfig, which is gitignored.
// Create it with scripts/configure.sh, or copy Local.xcconfig.example.

// An Apple Developer account is required. Without an overlay the project compiles
// ad-hoc signed as com.example.*, but macOS will not launch that build: the app and
// extension share a Keychain access group, which only a team-signed build may claim.
DEVELOPMENT_TEAM =
CODE_SIGN_IDENTITY = -

// Reverse-DNS prefix for both bundle identifiers, the app group and the Keychain group:
//   $(BUNDLE_ID_PREFIX).SendToTransmission and ….SendToTransmission.Extension
BUNDLE_ID_PREFIX = com.example

// Keychain service under which the RPC password is stored.
TRANSMISSION_KEYCHAIN_SERVICE = $(BUNDLE_ID_PREFIX).SendToTransmission.rpc

// Service name an earlier build saved the password under. When set, the extension
// moves that password to the service above the first time it runs.
TRANSMISSION_LEGACY_KEYCHAIN_SERVICE =

#include? "Local.xcconfig"
